common --enable_bzlmod

# Target JDK for code we build.
build --java_language_version=21
build --java_runtime_version=remotejdk_21

# JDK for build TOOLS — including rules_clojure's persistent worker. Without
# this the worker runs on Bazel's default tool JDK and fails compiling
# rules_clojure/fs.clj with ClassNotFoundException java.util.HexFormat
# (added in Java 17).
build --tool_java_language_version=21
build --tool_java_runtime_version=remotejdk_21

test --test_output=errors

# Stamped image tags need a git commit and the declared version; Bazel provides
# neither by default. The script never fails, so this cannot break a build.
build --workspace_status_command=bazel/tools/workspace_status.sh
