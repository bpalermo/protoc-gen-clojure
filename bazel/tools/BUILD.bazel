load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_library.bzl", "sh_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bazel/lint:linters.bzl", "shellcheck_test")

package(default_visibility = ["//visibility:public"])

# Rewrites clojure/versions.bzl with the sha256 of the released binaries.
#
# Still shell, and still outside the build graph, because its inputs are not Bazel
# artifacts: the binaries are produced by the release matrix and arrive as CI
# artifacts, so no rule can hash them. It is at least invoked through Bazel now,
# which is what got it linted.
sh_binary(
    name = "pin_versions",
    srcs = ["pin_versions.sh"],
)

# Invoked by Bazel itself via --workspace_status_command, not as a target, but a
# failure here breaks every build — so it is worth linting.
sh_library(
    name = "workspace_status",
    srcs = ["workspace_status.sh"],
)

# Every declared or documented version must equal MODULE.bazel's. The README
# snippets ship in the module archive and are checkable by nothing else: the
# release workflow's version gate reads plugin.clj and MODULE.bazel but not
# docs, which is how the 0.3.1 bump initially shipped install snippets still
# pointing at 0.3.0.
sh_test(
    name = "version_consistency_test",
    srcs = ["version_consistency_test.sh"],
    args = [
        "$(rootpath //:MODULE.bazel)",
        "$(rootpath //src/protoc_gen_clojure:plugin.clj)",
        "$(rootpath //:README.md)",
        "$(rootpath //examples/bzlmod:MODULE.bazel)",
    ],
    data = [
        "//:MODULE.bazel",
        "//:README.md",
        "//examples/bzlmod:MODULE.bazel",
        "//src/protoc_gen_clojure:plugin.clj",
    ],
)

shellcheck_test(
    name = "workspace_status_lint",
    srcs = [":workspace_status"],
    tags = ["lint"],
)

shellcheck_test(
    name = "pin_versions_lint",
    srcs = [":pin_versions"],
    tags = ["lint"],
)

shellcheck_test(
    name = "version_consistency_lint",
    srcs = [":version_consistency_test"],
    tags = ["lint"],
)
