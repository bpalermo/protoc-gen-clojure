"""Development-only targets: formatting and the release archive.

Kept out of the root package on purpose. The root BUILD file ships in the module
archive, so a `load` of any dev_dependency there would break every consumer at
BUILD-loading time. Nothing in this package is published.
"""

load("@aspect_rules_lint//format:defs.bzl", "format_multirun", "format_test")
load("@rules_img//img:image.bzl", "image_manifest")
load("@rules_img//img:layer.bzl", "file_metadata", "image_layer")
load("@rules_img//img:push.bzl", "image_push")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

# Formatters, which are the "fix it for me" half of lint:
#
#   bazel run  //bazel/dev:format        rewrite files in place
#   bazel test //bazel/dev:format_test   fail if anything is unformatted
#
# proto formatting deliberately uses OUR pinned buf rather than a bundled one, so
# the tool that formats is the same one that lints and the same one the
# distribution test verifies with.
# No shell formatter, deliberately. shfmt is only reachable via @multitool, and
# registering that hub requires a non-dev use_extension on a dev-only module —
# which makes @rules_multitool invisible to consumers and breaks every one of
# them at module-resolution time. shellcheck LINT is unaffected: rules_lint
# aliases it inside its own repo, where @multitool is visible.
format_multirun(
    name = "format",
    protocol_buffer = "@rules_buf_toolchains//:buf",
    starlark = "@buildifier_prebuilt//:buildifier",
)

format_test(
    name = "format_test",
    no_sandbox = True,
    protocol_buffer = "@rules_buf_toolchains//:buf",
    starlark = "@buildifier_prebuilt//:buildifier",
    tags = ["lint"],
    workspace = "//:MODULE.bazel",
)

# ---------------------------------------------------------------------------
# The module source archive BCR serves.
#
# Not GitHub's auto-generated tarball, because bazel/versions.bzl has to carry the
# sha256 of the native binaries released alongside it, and those cannot exist when
# the tag is cut. The release workflow pins them with //bazel/tools:pin_versions, then
# builds this.
#
# Deliberately curated rather than "everything git tracks":
#
#   - src/ and test/ are omitted. Their BUILD files load @rules_clojure, which is
#     a dev_dependency and therefore absent for a consumer — a package that cannot
#     load is worse than a package that is missing.
#   - examples/bzlmod IS included: BCR's presubmit uses it as the test module.
#
# The prefix is version-independent on purpose, so .bcr/source.template.json needs
# no {VERSION} substitution in strip_prefix.
filegroup(
    name = "module_srcs",
    srcs = [
        "//:BUILD.bazel",
        "//:LICENSE",
        "//:MODULE.bazel",
        "//:README.md",
        "//bazel:srcs",
        "//examples/bzlmod:srcs",
    ],
)

pkg_tar(
    name = "module_archive",
    srcs = [":module_srcs"],
    extension = "tar.gz",
    package_dir = "protoc-gen-clojure",
    # Workspace-relative paths inside the archive. "/" means the workspace root
    # rather than this package, which matters now that this lives in //bazel/dev.
    strip_prefix = "/",
)

# ---------------------------------------------------------------------------
# The container image for BSR remote plugin execution.
#
# The BSR runs remote plugins as containers. This is built but not pushed: public
# plugin publishing on buf.build is not self-serve, so there is nowhere to push it
# yet (see buf.plugin.yaml). Building it in CI is still worth it — it proves the
# artifact composes, which a Dockerfile nobody built did not.
#
# The binary comes straight from the build graph. That was the blocker when this
# was first attempted: native-image ran outside Bazel then, so an image rule would
# have had to consume a staged file and could not be built from a clean checkout.
image_layer(
    name = "plugin_layer",
    srcs = {"/protoc-gen-clojure": "//src/protoc_gen_clojure:protoc_gen_clojure"},
    file_metadata = {
        # protoc execs it, so the executable bit is not optional.
        "/protoc-gen-clojure": file_metadata(mode = "0755"),
    },
    # Same reason as the manifest: this is where the host-native binary would get
    # packaged, so the constraint belongs here too.
    target_compatible_with = ["@platforms//os:linux"],
)

image_manifest(
    name = "image",
    base = "@distroless_base",
    # [] explicitly UNSETS the cmd inherited from the base, rather than leaving it
    # to be inherited. The plugin takes no arguments: it reads a
    # CodeGeneratorRequest on stdin and writes the response to stdout, which is the
    # whole protocol, and is also why it satisfies the BSR sandbox.
    cmd = [],
    entrypoint = ["/protoc-gen-clojure"],
    layers = [":plugin_layer"],
    # Declared, not inherited. The image was already incompatible on macOS, but
    # only incidentally — the constraint came from the pulled base's platform. If
    # the base were ever swapped for a multi-platform index that protection would
    # vanish silently, and the result would be a host-native (darwin) binary
    # packaged into a Linux image: something that builds, pushes, and then cannot
    # run. GraalVM cannot cross-compile, so a Linux binary requires a Linux host.
    target_compatible_with = ["@platforms//os:linux"],
)

# ghcr.io, because it is a destination that exists. buf.build was aspirational:
# public plugin publishing there is not self-serve, so pushing was impossible.
# GitHub's registry needs only a token the release workflow already has.
#
# Tags are stamped from workspace status (see bazel/tools/workspace_status.sh):
# the version and the commit identify the artifact, and `latest` is the moving
# pointer. STABLE_ keys are part of the action cache key, so a new commit
# re-stamps rather than silently reusing a previous tag.
#
# stamp = "force" because the default defers to Bazel's --stamp, and a release
# that forgot the flag would push tags containing empty strings.
#
# manual keeps it out of wildcard builds — nothing should push by accident;
# `bazel run` still works, which is how the release invokes it.
image_push(
    name = "push",
    image = ":image",
    registry = "ghcr.io",
    repository = "bpalermo/protoc-gen-clojure",
    stamp = "force",
    tag_list = [
        "{{.STABLE_VERSION}}",
        "{{.STABLE_GIT_COMMIT}}",
        # `latest` moves only for a stable version. A prerelease must not claim it,
        # or `docker pull …:latest` hands someone a release candidate. The version
        # and commit tags are immutable and identify the artifact on their own, so
        # this only governs the convenience pointer.
        "{{if eq .STABLE_MOVING_TAG \"latest\"}}latest{{end}}",
    ],
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux"],
)
