load("@rules_clj//clojure:defs.bzl", "clj_binary", "clj_library", "clj_native_binary")

package(default_visibility = ["//visibility:public"])

# For //test:sandbox_conformance_test, which greps the source.
exports_files(["plugin.clj"])

# AOT matters here beyond startup time: a native image has no Clojure compiler in
# it, so anything that would be loaded from source at runtime cannot exist.
# clj_library compiles by default; `namespaces` is what gets compiled.
clj_library(
    name = "plugin",
    srcs = ["plugin.clj"],
    namespaces = ["protoc-gen-clojure.plugin"],
    strip_prefix = "src",
    deps = [
        "@maven//:com_google_protobuf_protobuf_java",
        "@maven//:org_clojure_clojure",
    ],
)

# The JVM plugin. protoc only requires something that reads a CodeGeneratorRequest
# on stdin and writes the response to stdout, so a launcher script qualifies — but
# it needs a JVM on the user's machine, which no other protoc plugin does. So the
# native binary is what ships; this is what the tests generate with, and it is also
# the input to native-image via its _deploy.jar.
clj_binary(
    name = "protoc_gen_clojure_jvm",
    main_class = "protoc_gen_clojure.plugin",
    deps = [
        ":plugin",
        "@maven//:com_google_protobuf_protobuf_java",
        "@maven//:org_clojure_clojure",
    ],
)

# The shipped artifact.
#
# --no-fallback and --initialize-at-build-time are not listed here any more: the rule
# forces both. The first because an image whose analysis did not close otherwise
# bundles a JVM and starts as slowly as the thing it was meant to replace; the second
# because Clojure's namespaces are built by static initialisers.
clj_native_binary(
    name = "protoc_gen_clojure",
    binary_name = "protoc-gen-clojure",
    extra_args = [
        "-H:+ReportExceptionStackTraces",
    ] + select({
        # Off unless --//bazel:static_musl=true. See //bazel:BUILD.bazel for why it is
        # opt-in and why it is x86_64 only.
        #
        # The zlib path is a convention rather than a discovered value: native-image
        # takes -H:CLibraryPath as a plain string, and the musl libz.a is built by
        # whoever sets the flag. The release workflow puts it exactly here; a local
        # build that sets the flag has to do the same.
        "//bazel:static_musl_enabled": [
            "--static",
            "--libc=musl",
            "-H:CLibraryPath=/opt/musl-zlib/lib",
        ],
        "//conditions:default": [],
    }),
    jar = ":protoc_gen_clojure_jvm_deploy.jar",
)
